<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Scarlet.Extensions.Hosting.Avalonia</PackageId>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>avalonia;hosting;generichost;dependencyinjection;desktop;aot;nativeaot</PackageTags>
    <Description>Microsoft.Extensions.Hosting (Generic Host) integration for Avalonia desktop apps on Windows, Linux and macOS. Runs the Avalonia UI thread inside the host, Native AOT compatible.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Scarlet.Extensions.Hosting.Avalonia.Tests" />
    <InternalsVisibleTo Include="Scarlet.Extensions.Hosting.Avalonia.ScenarioApp" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" Visible="false" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
